# ==============================================================================
# ForgeFlow Environment Configuration
# ==============================================================================

# Server Network Settings
# The address and port for the ForgeFlow HTTP REST API & Prometheus metrics server.
FORGEFLOW_ADDR=:8080
PORT=8080

# Storage Backend
# Options: "sqlite" (embedded zero-CGO WAL mode) or "postgres" (production SKIP LOCKED)
FORGEFLOW_DB_TYPE=postgres

# PostgreSQL Connection String (used when FORGEFLOW_DB_TYPE=postgres or when DATABASE_URL is set)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/forgeflow?sslmode=disable
# Alternatively:
# FORGEFLOW_DB_DSN=postgres://postgres:postgres@localhost:5432/forgeflow?sslmode=disable

# SQLite Database Path (used when FORGEFLOW_DB_TYPE=sqlite)
# FORGEFLOW_DB_DSN=forgeflow.db

# API Authentication Key
# API key used for X-API-Key HTTP header validation.
FORGEFLOW_API_KEY=ff_live_secret_key_1234567890

# Tenant Boundary
# Default tenant ID for multi-tenant isolation.
FORGEFLOW_TENANT_ID=default

# Worker Settings (used by 'forgeflow worker')
# Unique identifier for the worker node (auto-generated UUID if left blank)
FORGEFLOW_WORKER_ID=worker-node-1

# Queues to poll (comma-separated, ordered by priority)
FORGEFLOW_QUEUES=high-priority,default,low-priority

# Number of concurrent execution slots per worker daemon
FORGEFLOW_CONCURRENCY=10

# Polling interval for claiming queued jobs (e.g. 250ms, 1s)
FORGEFLOW_POLL_INTERVAL=250ms

# Lease duration before an unacknowledged job is considered abandoned
FORGEFLOW_LEASE_DURATION=30s

# Background Lease Reaper interval for sweeping expired running leases
FORGEFLOW_REAP_INTERVAL=5s
